# OpenAI API Key - Get one at: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=

# Google Maps API Key - Get one at: https://console.cloud.google.com/google/maps-apis
# Enable "Maps SDK for iOS" and "Maps SDK for Android"
# Note: Also configured in app.json for native builds
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Foursquare Places API Key (V3) - Get one at: https://location.foursquare.com/developer/
# Create a project, then get the API Key from the "API Keys" section
# Used for real venue validation, ratings, photos, and details
EXPO_PUBLIC_FOURSQUARE_API_KEY=
