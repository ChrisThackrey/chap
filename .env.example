# OpenAI API Key - Get one at: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=

# Google Maps API Key - Get one at: https://console.cloud.google.com/google/maps-apis
# Enable "Maps SDK for iOS", "Maps SDK for Android", "Places API (New)" and "Directions API".
# Injected into the native config by app.config.js at prebuild/build time, so it must be
# present when running `expo prebuild`, `expo run:ios` or an EAS build (see eas.json env).
# Restrict the key to the app's bundle id / package in Google Cloud; the JS clients send the
# X-Ios-Bundle-Identifier / X-Android-Package headers so REST calls keep working.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Foursquare Places API Key (V3) - Get one at: https://location.foursquare.com/developer/
# Create a project, then get the API Key from the "API Keys" section
# Used for real venue validation, ratings, photos, and details
EXPO_PUBLIC_FOURSQUARE_API_KEY=
